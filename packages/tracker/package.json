{
  "name": "@lobstah/tracker",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "deploy:worker": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "tail:worker": "wrangler tail"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@lobstah/protocol": "workspace:*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "wrangler": "^3.78.0"
  },
  "description": "Centralized HTTP tracker (signed-announcement registry, in-memory + TTL). Legacy fallback for environments where Nostr WebSockets are blocked.",
  "license": "MIT",
  "author": "Marouen Ben Guebila <marouen.b.guebila@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marouenbg/lobstah.git",
    "directory": "packages/tracker"
  },
  "bugs": {
    "url": "https://github.com/marouenbg/lobstah/issues"
  },
  "homepage": "https://github.com/marouenbg/lobstah/tree/main/packages/tracker#readme",
  "keywords": [
    "lobstah",
    "p2p",
    "decentralized",
    "mac-mini",
    "tracker",
    "discovery",
    "hono",
    "cloudflare-workers"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
