{
  "name": "@lobstah/openclaw-provider",
  "version": "0.0.5",
  "description": "OpenClaw model-provider plugin for the Lobstah distributed-inference grid. Adds 'Lobstah grid' as an OpenAI-compatible provider with opt-in Nostr discovery + opt-in advertising in the openclaw onboarding wizard.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "Marouen Ben Guebila <marouen.b.guebila@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marouenbg/lobstah.git",
    "directory": "openclaw-extension"
  },
  "bugs": {
    "url": "https://github.com/marouenbg/lobstah/issues"
  },
  "homepage": "https://github.com/marouenbg/lobstah/tree/main/openclaw-extension#readme",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "lobstah",
    "p2p",
    "llm-inference",
    "decentralized",
    "mac-mini",
    "nostr"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@lobstah/protocol": "workspace:*",
    "@lobstah/router": "workspace:*",
    "@lobstah/transport-nostr": "workspace:*"
  },
  "files": [
    "index.ts",
    "api.ts",
    "defaults.ts",
    "embedded-router.ts",
    "env-config.ts",
    "models.ts",
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "@lobstah/openclaw-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.25"
    },
    "compat": {
      "pluginApi": ">=2026.5.0"
    },
    "build": {
      "openclawVersion": "2026.5.2"
    }
  }
}
